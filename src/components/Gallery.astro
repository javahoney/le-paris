---
import SectionHead from './SectionHead.astro';
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  ctaLabel?: string;
  ctaHref?: string;
  count?: number;
}

const { eyebrow, title, ctaLabel, ctaHref, count = 6 } = Astro.props;
---

<div class="section">
  <SectionHead eyebrow={eyebrow} title={title} />
  <div class="wrap">
    <div class="gallery">
      {Array.from({ length: count }).map((_, i) => (
        <div class="gallery__item">
          <div class="gallery__ph"><span>Photo {i + 1}</span></div>
        </div>
      ))}
    </div>
    {ctaLabel && ctaHref && (
      <div class="gallery__cta">
        <Button href={ctaHref} variant="primary">{ctaLabel}</Button>
      </div>
    )}
  </div>
</div>

<style>
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .gallery__item { aspect-ratio: 1/1; overflow: hidden; position: relative; }
  .gallery__ph { width: 100%; height: 100%; background: linear-gradient(135deg, #e8c9a0, #d99a5b); display: flex; align-items: center; justify-content: center; }
  .gallery__ph span { font-family: var(--font-title); color: #7A173588; font-size: 1rem; }
  .gallery__cta { text-align: center; margin-top: 32px; }

  @media (max-width: 700px) {
    .gallery { grid-template-columns: 1fr; }
  }
</style>
