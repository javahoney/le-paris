---
interface Props {
  name: 'plats' | 'chaudes' | 'aperitifs' | 'bieres' | 'vins' | 'softs' | 'cocktails';
  variant: 'light' | 'dark';
}

const { name, variant } = Astro.props;

const sizes: Record<string, { size: number; position: string }> = {
  plats: { size: 280, position: 'top:-42px; right:-38px;' },
  chaudes: { size: 200, position: 'bottom:-40px; right:-40px;' },
  aperitifs: { size: 180, position: 'bottom:-34px; right:-26px;' },
  bieres: { size: 210, position: 'bottom:-42px; right:-34px;' },
  vins: { size: 195, position: 'bottom:-36px; right:-28px;' },
  softs: { size: 200, position: 'bottom:-36px; right:-34px;' },
  cocktails: { size: 185, position: 'bottom:-32px; right:-22px;' },
};

const { size, position } = sizes[name];
---

<svg
  class:list={['card-icon', variant]}
  style={`width:${size}px; height:${size}px; ${position}`}
  viewBox="0 0 100 100"
  fill="none"
  stroke="currentColor"
  stroke-width="4"
  stroke-linecap="round"
>
  {name === 'plats' && (
    <>
      <path d="M30 10v35c0 6-8 6-8 0V10M22 10v20M38 10v35" />
      <path d="M38 10v80" />
      <path d="M70 10c-10 0-14 10-14 22s4 14 14 14v34" />
    </>
  )}
  {name === 'chaudes' && (
    <>
      <path d="M20 40h50v22c0 12-11 20-25 20s-25-8-25-20V40z" />
      <path d="M70 45h6c6 0 10 5 10 11s-4 11-10 11h-6" />
      <path d="M32 30c-3-4 3-6 0-12M45 30c-3-4 3-6 0-12" />
    </>
  )}
  {name === 'aperitifs' && (
    <>
      <path d="M30 20h40l-8 55c0 8-24 8-24 0L30 20z" />
      <path d="M25 20h50" />
    </>
  )}
  {name === 'bieres' && (
    <>
      <path d="M22 32h42v42c0 8-8 12-21 12s-21-4-21-12V32z" />
      <path d="M64 40h8c6 0 10 5 10 12s-4 12-10 12h-8" />
      <path d="M25 32c0-8 4-14 4-14M35 32c0-10 6-16 6-16" />
    </>
  )}
  {name === 'vins' && (
    <>
      <path d="M28 15c-4 14-4 24 6 30 6 4 10 10 10 18 0 10-8 14-8 14M56 15c4 14 4 24-6 30-6 4-10 10-10 18 0 10 8 14 8 14" />
      <path d="M28 15h28" />
      <path d="M36 77h16" />
    </>
  )}
  {name === 'softs' && (
    <>
      <path d="M28 30h44l-6 55c0 4-32 4-32 0L28 30z" />
      <path d="M60 15l4 25M60 15l-8 10" />
      <path d="M32 45h36M35 60h30" />
    </>
  )}
  {name === 'cocktails' && (
    <>
      <path d="M18 20h64L50 55 18 20z" />
      <path d="M50 55v25M35 80h30" />
      <circle cx="60" cy="30" r="4" fill="currentColor" stroke="none" />
    </>
  )}
</svg>

<style>
  .card-icon { position: absolute; z-index: 0; pointer-events: none; transform: rotate(-14deg); }
  .card-icon.light { color: var(--color-bordeaux); opacity: 0.07; }
  .card-icon.dark { color: var(--color-creme); opacity: 0.1; }
</style>
