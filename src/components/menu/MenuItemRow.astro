---
interface Props {
  name: string;
  note?: string;
  price: string;
  /** Ligne mise en valeur au sein de la carte (ex. "Plat du jour") — distinct du `featured` de MenuCategoryCard. */
  isPlatDuJour?: boolean;
}

const { name, note, price, isPlatDuJour = false } = Astro.props;
---

<div class:list={['item-row', { 'is-plat-du-jour': isPlatDuJour }]}>
  <span class="item-name">{name} {note && <span class="item-note">{note}</span>}</span>
  <span class="leader"></span>
  <span class="item-price">{price}</span>
</div>

<style>
  .is-plat-du-jour .item-name { text-transform: uppercase; letter-spacing: 0.03em; }
</style>
