---
interface Props {
  name: string;
  note?: string;
  price: string;
  featured?: boolean;
}

const { name, note, price, featured = false } = Astro.props;
---

<div class:list={['item-row', { 'featured-row': featured }]}>
  <span class="item-name">{name} {note && <span class="item-note">{note}</span>}</span>
  <span class="leader"></span>
  <span class="item-price">{price}</span>
</div>

<style>
  .featured-row .item-name { text-transform: uppercase; letter-spacing: 0.03em; }
</style>
