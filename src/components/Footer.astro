---
import InfosPratiques from './InfosPratiques.astro';
import InfoBlock from './InfoBlock.astro';

interface Props {
  theme: 'light' | 'dark';
  active: 'accueil' | 'carte' | 'karaoke' | 'traiteur';
}

const { theme, active } = Astro.props;

const links = [
  { key: 'accueil', label: 'Accueil', href: '/' },
  { key: 'carte', label: 'Carte', href: '/carte' },
  { key: 'traiteur', label: 'Traiteur', href: '/traiteur' },
  { key: 'karaoke', label: 'Karaoké', href: '/karaoke' },
];
---

<footer>
  <InfosPratiques dark={theme === 'dark'}>
    <InfoBlock label="Adresse">49 Av. de Paris<br />45000 Orléans</InfoBlock>
    <InfoBlock label="Horaires">Lundi – Vendredi<br />08h00–15h00 | 17h00–19h30</InfoBlock>
    <InfoBlock label="Téléphone"><a href="tel:0238532934">02 38 53 29 34</a></InfoBlock>
  </InfosPratiques>

  <div class:list={['footer', { 'footer--dark': theme === 'dark' }]}>
    <div class="footer__links">
      {links.map((link) => (
        <a
          class:list={['navlink', { active: link.key === active }]}
          href={link.href}
        >
          {link.label}
        </a>
      ))}
    </div>
    <div class="footer__socials">
      <a href="https://www.instagram.com/le_paris.bar/" aria-label="Instagram" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.057 1.17-.253 1.805-.418 2.227-.224.562-.479.96-.897 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.057-1.816-.253-2.236-.418-.569-.224-.96-.479-1.379-.897-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.165 1.051-.36 2.221-.421 1.275-.045 1.65-.06 4.859-.06zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/></svg>
      </a>
      <a href="https://www.facebook.com/share/1SsaYf2PMN/?mibextid=wwXIfr" aria-label="Facebook" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z"/></svg>
      </a>
      <a href="https://www.youtube.com/@leparisbarorleans" aria-label="YouTube" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a2.999 2.999 0 00-2.112-2.124C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.386.517A2.999 2.999 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a2.999 2.999 0 002.112 2.124c1.881.517 9.386.517 9.386.517s7.505 0 9.386-.517a2.999 2.999 0 002.112-2.124C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>
      <a href="https://www.google.com/maps/place/Le+Pari's/@47.9105883,1.9014424,585m/data=!3m2!1e3!4b1!4m6!3m5!1s0x47e4fb2be466c775:0xafa83b843ac2d826!8m2!3d47.9105847!4d1.9040173!16s%2Fg%2F1tczztjr?entry=ttu&g_ep=EgoyMDI2MDMxOC4xIKXMDSoASAFQAw%3D%3D" aria-label="Google Maps" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C7.86 2 4.5 5.36 4.5 9.5c0 5.5 7.5 12.5 7.5 12.5s7.5-7 7.5-12.5C19.5 5.36 16.14 2 12 2zm0 10.25a2.75 2.75 0 110-5.5 2.75 2.75 0 010 5.5z"/></svg>
      </a>
    </div>
    <a class="footer__email" href="mailto:leparisbarorleans@gmail.com">leparisbarorleans@gmail.com</a>
    <p>© 2026 Le Pari's — Bar Restaurant</p>
  </div>
</footer>

<style>
  .footer { padding: 32px 24px; text-align: center; }
  .footer__links { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-bottom: 32px; }
  .navlink {
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--color-bordeaux);
    background: #fff;
    padding: 8px 18px;
    border-radius: var(--radius-none);
    border: 1.5px solid #7A173522;
    transition: 0.2s;
  }
  .navlink.active,
  .navlink:hover { background: var(--color-bordeaux); color: var(--color-creme); border-color: var(--color-bordeaux); }

  .footer p { font-size: 0.85rem; color: var(--color-text-secondary); margin-top: 16px; }
  .footer__email { font-family: var(--font-title); font-size: 1rem; color: var(--color-bordeaux); text-decoration: none; margin-top: 4px; display: inline-block; }
  .footer__socials { display: flex; justify-content: center; gap: 18px; margin: 0 0 22px; }
  .footer__socials a { width: 38px; height: 38px; border-radius: var(--radius-circle); background: var(--color-bordeaux); display: flex; align-items: center; justify-content: center; transition: 0.2s; }
  .footer__socials a:hover { background: var(--color-orange); }
  .footer__socials svg { width: 18px; height: 18px; fill: var(--color-creme); }

  /* DARK THEME (Karaoké) */
  .footer--dark .navlink {
    color: var(--color-text-on-dark);
    background: var(--color-dark-card);
    border: 1.5px solid #E8821E44;
  }
  .footer--dark .navlink.active,
  .footer--dark .navlink:hover { background: var(--color-orange); color: var(--color-dark-nav); border-color: var(--color-orange); }
  .footer--dark p { color: var(--color-dark-text-secondary); }
  .footer--dark .footer__email { color: var(--color-orange); }
  .footer--dark .footer__socials a { background: var(--color-dark-card); }
  .footer--dark .footer__socials a:hover { background: var(--color-orange); }
  .footer--dark .footer__socials svg { fill: var(--color-orange); }
  .footer--dark .footer__socials a:hover svg { fill: var(--color-dark-nav); }

  @media (max-width: 760px) {
    .footer { padding: 32px 12px calc(64px + env(safe-area-inset-bottom, 0px)); }
  }
</style>
