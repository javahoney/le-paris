---
import Layout from '../layouts/Layout.astro';
import HandTag from '../components/HandTag.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import Chip from '../components/Chip.astro';
import Gallery from '../components/Gallery.astro';
import PrestaCard from '../components/traiteur/PrestaCard.astro';
import MenuItemRow from '../components/menu/MenuItemRow.astro';
import FloatingBadge from '../components/FloatingBadge.astro';
import traiteurPhoto1 from '../assets/traiteur-gallery-1.webp';
import traiteurPhoto2 from '../assets/traiteur-gallery-2.webp';
import traiteurPhoto3 from '../assets/traiteur-gallery-3.webp';
import traiteurPhoto4 from '../assets/traiteur-gallery-4.webp';
import traiteurPhoto5 from '../assets/traiteur-gallery-5.webp';
import traiteurPhoto6 from '../assets/traiteur-gallery-6.webp';
import { buildTraiteurServiceSchema } from '../data/schema';

const formules = [
  { name: 'Plateau repas individuel', price: 'sur devis' },
  { name: 'Cocktail dînatoire', price: 'sur devis' },
  { name: 'Buffet froid / chaud', price: 'sur devis' },
  { name: 'Service & dressage sur place', price: 'sur devis' },
];

const galleryImages = [
  { src: traiteurPhoto1, alt: "Plateau repas préparé par le service traiteur du Pari's à Orléans" },
  { src: traiteurPhoto2, alt: "Buffet dressé pour une prestation traiteur du Pari's à Orléans" },
  { src: traiteurPhoto3, alt: "Pièces cocktail réalisées par l'équipe traiteur du Pari's à Orléans" },
  { src: traiteurPhoto4, alt: "Dressage sur place d'une prestation traiteur du Pari's à Orléans" },
  { src: traiteurPhoto5, alt: "Buffet froid préparé par le service traiteur du Pari's à Orléans" },
  { src: traiteurPhoto6, alt: "Prestation traiteur réalisée par Le Pari's à Orléans" },
];

const zones = ['Orléans', 'Saint-Jean-de-Braye', 'Olivet', 'Saran', 'Fleury-les-Aubrais', 'La Chapelle-Saint-Mesmin', 'Saint-Jean-le-Blanc', 'Ingré'];

const devisSubject = "Demande de devis traiteur - Le Pari's";
const devisBody = `Bonjour,

Je souhaite obtenir un devis pour une prestation traiteur.

Voici les détails de mon événement :
- Date :
- Nombre d'invités :
- Lieu :
- Type d'événement (mariage, anniversaire, entreprise...) :
- Budget approximatif :

Merci de me recontacter pour en discuter.

Cordialement,`;
const devisHref = `mailto:leparisbarorleans@gmail.com?subject=${encodeURIComponent(devisSubject)}&body=${encodeURIComponent(devisBody)}`;
---

<Layout
  title="Traiteur à Orléans et alentours — Le Pari's"
  description="Le Pari's, bar-restaurant à Orléans, propose ses services de traiteur pour mariages, anniversaires et événements d'entreprise, à Orléans et alentours."
  active="traiteur"
  ogImage={traiteurPhoto3}
  jsonLd={buildTraiteurServiceSchema(zones)}
>
  <FloatingBadge label="Demander un devis" phone="02 38 53 29 34" variant="orange" />

  <div class="hero">
    <HandTag rotate={-3}>traiteur événementiel</HandTag>
    <h1 class="pd">Traiteur à Orléans<br />et ses alentours</h1>
    <p class="hero__sub">Les recettes du Pari's, livrées ou dressées sur place pour vos événements professionnels et privés : mariages, anniversaires, cocktails d'entreprise, buffets.</p>
    <div class="hero__ctas">
      <Button href={devisHref} variant="primary">Demander un devis</Button>
    </div>
  </div>

  <div class="section" id="prestations">
    <div class="wrap">
      <SectionHead
        eyebrow="nos services"
        title="Nos prestations"
        description="On s'adapte à votre nombre d'invités et au lieu."
      />
      <div class="prestations">
        <PrestaCard title="Entreprises">
          <Fragment slot="icon">
            <rect x="3" y="7" width="18" height="13" rx="1"></rect>
            <path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"></path>
            <line x1="3" y1="12" x2="21" y2="12"></line>
          </Fragment>
          Plateaux repas, cocktails, séminaires et pots de départ. Une prestation pour vos événements professionnels à Orléans.
        </PrestaCard>
        <PrestaCard title="Mariages & Anniversaires">
          <Fragment slot="icon">
            <path d="M12 21c-5-3-9-6.5-9-11a5 5 0 019-3 5 5 0 019 3c0 4.5-4 8-9 11z"></path>
          </Fragment>
          Buffets généreux et plats faits maison pour marquer les grandes occasions en famille ou entre amis, dans les environs d'Orléans.
        </PrestaCard>
        <PrestaCard title="Cocktails & Buffets">
          <Fragment slot="icon">
            <path d="M12 3l2.5 5 5.5.8-4 3.9.9 5.3L12 15.5 7.1 18l.9-5.3-4-3.9L9.5 8z"></path>
          </Fragment>
          Pièces salées et sucrées, planches à partager, service sur place ou à emporter selon vos besoins et le format de votre réception.
        </PrestaCard>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="wrap">
      <div class="formule-card">
        <HandTag>quelques idées de formules</HandTag>
        <h2 class="pd">Nos formules traiteur</h2>
        <div class="formule-list">
          {formules.map((f) => (
            <MenuItemRow name={f.name} price={f.price} />
          ))}
        </div>
        <div class="cta">
          <Button href={devisHref} variant="secondary" onDark>Nous écrire pour un devis</Button>
        </div>
      </div>
    </div>
  </div>

  <Gallery eyebrow="quelques réalisations" title="Nos événements" ctaLabel="Demander un devis" ctaHref={devisHref} images={galleryImages} />

  <div class="section">
    <div class="wrap">
      <SectionHead
        eyebrow="zone d'intervention"
        title="Traiteur autour d'Orléans"
        description="Le Pari's intervient à Orléans et dans les communes environnantes pour vos réceptions."
      />
      <div class="zone-chips">
        {zones.map((zone) => <Chip>{zone}</Chip>)}
      </div>
    </div>
  </div>
</Layout>

<style>
  .hero { text-align: center; padding: 70px 24px 56px; }
  .hero h1 { font-size: clamp(2.8rem, 7vw, 4.2rem); color: var(--color-bordeaux); font-weight: 700; line-height: 1.05; }
  .hero__sub { font-size: 1.05rem; color: var(--color-bordeaux-dark); margin-top: 16px; max-width: 560px; margin-left: auto; margin-right: auto; }
  .hero__ctas { display: flex; justify-content: center; gap: 14px; margin-top: 32px; flex-wrap: wrap; }

  .prestations { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

  .formule-card {
    background: radial-gradient(circle at 15% 15%, #8a1e3f 0%, #7A1735 45%, #6b1430 100%);
    padding: 40px;
    box-shadow: 0 8px 28px rgba(122, 23, 53, 0.25);
  }
  .formule-card h2 { color: var(--color-creme); font-size: 2.1rem; font-weight: 700; margin-bottom: 22px; }
  .formule-list { display: grid; grid-template-columns: 1fr; gap: 10px; }
  .formule-list :global(.item-name) { color: var(--color-creme); }
  .formule-list :global(.item-note) { color: #F3E4D299; }
  .formule-list :global(.leader) { border-bottom-color: #FBF3E766; }
  .formule-list :global(.item-price) { font-size: 1rem; color: var(--color-white); }
  .formule-card .cta { margin-top: 28px; text-align: center; }

  .zone-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }

  @media (max-width: 760px) {
    .prestations { grid-template-columns: 1fr; }
    .hero { padding: 70px 12px 56px; }
    .hero h1 { font-size: 2.3rem; }
    .formule-card { padding: 20px 16px; }
    .formule-card h2 { font-size: 1.7rem; }
    :global(.zone-chips .chip) { font-size: 0.72rem; padding: 6px 12px; }
  }
</style>
