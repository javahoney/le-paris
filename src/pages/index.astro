---
import Layout from '../layouts/Layout.astro';
import HandTag from '../components/HandTag.astro';
import Button from '../components/Button.astro';
import Gallery from '../components/Gallery.astro';
import FloatingBadge from '../components/FloatingBadge.astro';
import photo1 from '../assets/photo-gallery-1.webp';
import photo2 from '../assets/photo-gallery-2.webp';
import photo3 from '../assets/photo-gallery-3.webp';
import photo4 from '../assets/photo-gallery-4.webp';
import photo5 from '../assets/photo-gallery-5.webp';
import photo6 from '../assets/photo-gallery-6.webp';
import { buildRestaurantSchema } from '../data/schema';

const galleryImages = [
  { src: photo1, alt: "Pavé de saumon grillé sur lit de spaghettis, servi au restaurant Le Pari's à Orléans" },
  { src: photo2, alt: "Moules marinières et frites, une spécialité du Pari's à Orléans" },
  { src: photo3, alt: "Steak tartare et frites maison dressés en salle, au restaurant Le Pari's" },
  { src: photo4, alt: "Choucroute garnie préparée au Pari's, bar-restaurant à Orléans" },
  { src: photo5, alt: "Brochettes grillées et sauce tzatziki, plat du restaurant Le Pari's à Orléans" },
  { src: photo6, alt: "Salade de poulpe grillé et pommes de terre, servie au Pari's à Orléans" },
];
---

<Layout
  title="Le Pari's — Bar-restaurant à Orléans"
  description="Bar-restaurant convivial au cœur d'Orléans : cuisine maison généreuse, large choix de boissons et soirées karaoké, dans une ambiance familiale et chaleureuse."
  active="accueil"
  ogImage={photo3}
  jsonLd={buildRestaurantSchema()}
>
  <FloatingBadge label="Réserver une table" phone="02 38 53 29 34" variant="green" />

  <div class="hero">
    <HandTag rotate={-2}>bar · restaurant</HandTag>
    <h1 class="pd">Le Pari's</h1>
    <p class="hero__sub">Une ambiance familiale. Une table généreuse et un bar convivial.<span class="hero__phone">02 38 53 29 34</span></p>
    <div class="hero__ctas">
      <Button href="/carte" variant="primary">Voir la carte</Button>
      <Button href="/traiteur" variant="secondary">Traiteur</Button>
    </div>
  </div>

  <Gallery eyebrow="un aperçu" title="Chez nous" ctaLabel="Voir la carte" ctaHref="/carte" images={galleryImages} />
</Layout>

<style>
  .hero { text-align: center; padding: 70px 24px 56px; position: relative; overflow: hidden; }
  .hero h1 { font-size: clamp(3.2rem, 9vw, 5rem); color: var(--color-bordeaux); font-weight: 700; line-height: 1; }
  .hero__sub { font-size: 1.05rem; color: var(--color-bordeaux-dark); margin-top: 16px; max-width: 480px; margin-left: auto; margin-right: auto; }
  .hero__phone { display: block; margin-top: 10px; }
  .hero__ctas { display: flex; justify-content: center; gap: 14px; margin-top: 32px; flex-wrap: wrap; }

  @media (max-width: 760px) {
    .hero { padding: 70px 12px 56px; }
    .hero h1 { font-size: 2.6rem; }
  }
</style>
